<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- Gradient principal -->
    <linearGradient id="mainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2563EB;stop-opacity:1" />
    </linearGradient>
    
    <!-- Gradient secondaire -->
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
    
    <!-- Ombre douce -->
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000000" flood-opacity="0.15"/>
    </filter>
    
    <!-- Brillance -->
    <linearGradient id="shine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.3" />
      <stop offset="50%" style="stop-color:#ffffff;stop-opacity:0.1" />
      <stop offset="100%" style="stop-color:#ffffff;stop-opacity:0" />
    </linearGradient>
  </defs>
  
  <!-- Fond de forme hexagonale moderne -->
  <g transform="translate(256, 256)">
    <!-- Hexagone extérieur -->
    <path d="M0,-180 L155.88,-90 L155.88,90 L0,180 L-155.88,90 L-155.88,-90 Z" 
          fill="url(#mainGradient)" 
          filter="url(#softShadow)"
          rx="20"/>
    
    <!-- Brillance sur le hexagone -->
    <path d="M0,-180 L155.88,-90 L155.88,90 L0,180 L-155.88,90 L-155.88,-90 Z" 
          fill="url(#shine)"/>
  </g>
  
  <!-- Icône centrale : Document avec check -->
  <g transform="translate(256, 256)">
    <!-- Document stylisé -->
    <g transform="translate(-60, -80)">
      <!-- Page principale -->
      <rect x="0" y="0" width="120" height="150" rx="12" fill="#FFFFFF"/>
      
      <!-- Coin plié -->
      <path d="M85,0 L120,0 L120,35 Z" fill="#E5E7EB"/>
      <path d="M85,0 L120,35 L85,35 Z" fill="#FFFFFF"/>
      
      <!-- Lignes de texte abstraites -->
      <rect x="15" y="25" width="60" height="8" rx="4" fill="#E5E7EB"/>
      <rect x="15" y="45" width="90" height="6" rx="3" fill="#F3F4F6"/>
      <rect x="15" y="58" width="80" height="6" rx="3" fill="#F3F4F6"/>
      <rect x="15" y="71" width="85" height="6" rx="3" fill="#F3F4F6"/>
      <rect x="15" y="84" width="50" height="6" rx="3" fill="#F3F4F6"/>
      
      <!-- Cercle check (badge vert) -->
      <circle cx="95" cy="120" r="28" fill="url(#accentGradient)" filter="url(#softShadow)"/>
      
      <!-- Check mark -->
      <path d="M83,120 L91,128 L107,112" 
            stroke="#FFFFFF" 
            stroke-width="5" 
            stroke-linecap="round" 
            stroke-linejoin="round"
            fill="none"/>
    </g>
  </g>
</svg>
